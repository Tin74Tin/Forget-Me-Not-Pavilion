# --- Next.js admin app (public + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase Edge Function: supabase/functions/daily-reminders ---
# Set these via `supabase secrets set` (see README) — NOT read by Next.js.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   (keep this secret!)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_CONTENT_SID=              # leave unset while testing in the sandbox
# DEFAULT_TIMEZONE=Asia/Singapore
